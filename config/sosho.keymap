//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

//OS は JIS 配列(106キー)前提。記号のキーコードは JIS で出る文字に合わせてある
// : = SQT / ( = LS(N8) / ) = LS(N9) / + = LS(SEMI) / * = LS(SQT)

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };

		//タップで文字、長押しで修飾キー(Z/V/M=Shift、C/,=Ctrl)
		//打鍵中(直前150ms以内にキー入力あり)は必ず文字になる
        hm: tap_hold_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//D+F 同時押しで かな(カタカナひらがなキー → IMEオン)
	    combo_KANA {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp INT_KATAKANAHIRAGANA>;
            layers = <0>;
        };

		//J+K 同時押しで 英数(無変換キー → MS-IME の設定で IME-オフ を割り当てる)
        combo_EISU {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp INT_MUHENKAN>;
            layers = <0>;
        };
    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp ESC       &kp Q  &kp W          &kp E          &kp R  &kp T      &kp Y  &kp U          &kp I              &kp O    &kp P      &kp MINUS
            &kp TAB       &kp A  &kp S          &kp D          &kp F  &kp G      &kp H  &kp J          &kp K              &kp L    &kp SQT    &kp ENTER
            &kp LSHFT     &hm LSHFT Z    &kp X  &hm LCTRL C    &hm LSHFT V    &kp B             &kp N  &hm RSHFT M    &hm RCTRL COMMA    &kp DOT  &kp LS(N8) &kp LS(N9)
            &kp LCTRL     &kp LALT              &kp SPACE      &mo 1             &mo 2  &none                             &kp INT_HENKAN &none
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

	//左手: 矢印(E=↑、S D F=← ↓ →) / 右手: テンキー
    layer_1 {
        bindings = <
            &trans    &trans &trans    &kp UP    &trans     &trans     &kp N7 &kp N8 &kp N9 &kp MINUS    &kp SLASH   &kp DEL
            &trans    &trans &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &kp N4 &kp N5 &kp N6 &kp LS(SEMI) &kp LS(SQT) &trans
            &trans    &trans &trans    &trans    &trans     &trans     &kp N1 &kp N2 &kp N3 &kp DOT      &trans      &trans
            &trans    &trans                     &trans     &trans     &kp ENTER &kp N0                  &trans      &trans
        >;
    };

	//右親指(MO2)を押したまま左親指で レイヤー3(Bluetooth)
    layer_2 {
        bindings = <
            &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &trans  &trans    &kp MINUS &kp EQUAL &trans     &trans
            &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &kp LBKT  &kp RBKT  &kp NUBS  &trans     &trans
            &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &trans  &kp SEMI  &kp SQT   &trans    &kp QMARK  &kp BSLH
            &trans &trans                  &trans  &mo 3      &trans  &trans                        &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &trans         &trans
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans      &trans  &out OUT_BLE                                    &trans         &trans
        >;
    };

	//オートマウスレイヤー: 右トラックパッドを動かすと有効になる(sosho_R_trackpad.overlay で設定)
    mouse_layer {
        bindings = <
            &trans &trans &trans &trans    &trans    &trans      &trans  &trans  &trans     &trans     &trans     &trans
            &trans &trans &trans &trans    &trans    &trans      &trans  &trans  &trans     &trans     &trans     &trans
            &trans &trans &trans &trans    &trans    &trans      &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans
            &trans &trans                  &mkp RCLK &mkp LCLK   &trans  &trans                        &trans     &trans
        >;
    };

    extra2 {
        status = "reserved";
    };
};
};
